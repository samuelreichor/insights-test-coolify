{% extends "_layouts/_layout-base.twig" %}

{% block body %}
  {{ include('_components/navigation.twig') }}

  {% llmify %}
    {{ include('_components/hero.twig', {
      data: {
        headline: entry.hero.headline ?? entry.title ?? '',
        text: entry.hero.text ?? '',
        image: entry.hero.image.eagerly().one() ?? null,
      }
    }, with_context = false) }}

    {{ include('_components/builder.twig', {
      data: {
        builder: entry.pageBuilder ?? null,
      }
    }, with_context = false) }}
  {% endllmify %}

  {{ include('_components/footer.twig') }}
{% endblock %}
