{% extends "_layouts/_layout-base.twig" %}

{% block body %}
  <ul class="nav">
    {% set es = craft.entries.all() %}
    {% for e in es %}
      <li>
        <a href="{{ e.getUrl() }}">{{ e.title }}</a>
      </li>
    {% endfor %}
  </ul>
  <h1>{{ entry.title }}</h1>

  <div class="box1"></div>
  <div class="box2"></div>
  <div class="box1"></div>
  <div class="box2"></div>
  <div class="box1"></div>
  <div class="box2"></div>
  <div class="box1"></div>
  <div class="box2"></div>
  <style>
    .box1 {
      width: 100%;
      height: 600px;
      background-color: #0d9488;
    }

    .box2 {
      width: 100%;
      height: 600px;
      background-color: #1f5fea;
    }

    .nav {
      width: 100%;
      display: flex;
      gap: 16px;
      list-style-type: none;
    }
  </style>
{% endblock %}
